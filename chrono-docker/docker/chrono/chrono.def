# SPDX-License-Identifier: MIT
# Apptainer/Singularity definition for Project Chrono on AMD ROCm/HIP.
#
# This is the Apptainer translation of chrono.dockerfile, for HPC clusters
# (e.g. HPC Fund) where Docker is unavailable. It bakes the system + ROS
# dependencies and chrono_ros_interfaces into the image; the Chrono source
# itself is compiled at runtime by buildChronoInMount.sh against a bind-mounted
# work directory (so build artifacts live on $WORK, not inside the .sif).
#
# Build (on the login node — egress + unprivileged fakeroot both work here):
#   cd docker/chrono
#   apptainer build --fakeroot "$WORK/chrono.sif" chrono.def
# Override ROCm/ROS versions with e.g.:
#   apptainer build --fakeroot --build-arg ROCM_VERSION=6.4.1 "$WORK/chrono.sif" chrono.def

Bootstrap: docker
From: rocm/dev-ubuntu-22.04:{{ ROCM_VERSION }}-complete

%arguments
    ROCM_VERSION=7.2.4
    ROS_DISTRO=humble

%files
    ros_entrypoint.sh /opt/ros_entrypoint.sh

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    ROS_DISTRO={{ ROS_DISTRO }}

    # Sanity: confirm we are on an Ubuntu base (mirrors the dockerfile guard).
    grep -qi "ubuntu" /etc/os-release || { echo "Error: image is not Ubuntu-based"; exit 1; }

    # --- ROS 2 apt repository -------------------------------------------------
    apt-get update
    apt-get install --no-install-recommends -y \
        curl gnupg lsb-release software-properties-common ca-certificates
    add-apt-repository universe
    # Toolchain PPA for g++-13: ROCm 7.x rocThrust/rocPRIM headers use _Float16,
    # which Ubuntu 22.04's default g++-11 does not support on x86. The Chrono dev
    # built successfully with g++ 13.3.0, so we install and use g++-13 as host CXX.
    add-apt-repository -y ppa:ubuntu-toolchain-r/test
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
        | tee /etc/apt/sources.list.d/ros2.list > /dev/null

    # --- Chrono build deps + ROS base ----------------------------------------
    # Union of the dockerfile base list and the atk.yml APT_DEPENDENCIES.
    # NOTE: Chrono::Sensor is intentionally NOT built (NVIDIA OptiX only), so
    # no OptiX/CUDA packages are installed here.
    apt-get update && apt-get install --no-install-recommends -y \
        python3-pip \
        python-is-python3 \
        python3.10 \
        python3.10-dev \
        sudo \
        git \
        cmake \
        cmake-curses-gui \
        build-essential \
        gcc-13 \
        g++-13 \
        ninja-build \
        swig \
        libirrlicht-dev \
        libeigen3-dev \
        libxxf86vm-dev \
        x11proto-gl-dev \
        freeglut3-dev \
        python3-numpy \
        libglu1-mesa-dev \
        mesa-common-dev \
        libglew-dev \
        libglfw3 \
        libglfw3-dev \
        libblas-dev \
        liblapack-dev \
        libopenmpi-dev \
        openmpi-common \
        libhdf5-dev \
        libfastcdr-dev \
        libfastrtps-dev \
        wget \
        unzip \
        nano \
        xorg-dev \
        xauth \
        python3-colcon-common-extensions \
        ros-${ROS_DISTRO}-ros-base

    # --- Vulkan SDK for Chrono::VSG ------------------------------------------
    wget -qO- https://packages.lunarg.com/lunarg-signing-key-pub.asc \
        | tee /etc/apt/trusted.gpg.d/lunarg.asc
    UBUNTU_CODENAME=$(lsb_release -cs)
    wget -qO /etc/apt/sources.list.d/lunarg-vulkan.list \
        "http://packages.lunarg.com/vulkan/lunarg-vulkan-${UBUNTU_CODENAME}.list"
    apt-get update
    apt-get install --no-install-recommends -y vulkan-sdk

    apt-get clean && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

    chmod +x /opt/ros_entrypoint.sh

    # --- chrono_ros_interfaces (baked into the image) ------------------------
    # Built into a neutral /opt path (Apptainer runs as the invoking host user,
    # so there is no chrono-user $HOME to install into as in the Docker image).
    ROS_WORKSPACE_DIR=/opt/ros2_ws
    mkdir -p ${ROS_WORKSPACE_DIR}/src/chrono_ros_interfaces
    git clone https://github.com/projectchrono/chrono_ros_interfaces.git \
        ${ROS_WORKSPACE_DIR}/src/chrono_ros_interfaces
    bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && cd ${ROS_WORKSPACE_DIR} && colcon build"

%environment
    export ROS_DISTRO={{ ROS_DISTRO }}
    export ROCM_PATH=/opt/rocm
    export PATH=/opt/rocm/bin:$PATH
    export TERM=xterm-256color
    # ROS + chrono_ros_interfaces overlays (guarded; tolerate ROS's unbound vars)
    if [ -f /opt/ros/${ROS_DISTRO}/setup.sh ]; then . /opt/ros/${ROS_DISTRO}/setup.sh; fi
    if [ -f /opt/ros2_ws/install/setup.sh ]; then . /opt/ros2_ws/install/setup.sh; fi
    # Runtime Chrono env produced by buildChronoInMount.sh (path passed in by caller)
    if [ -n "${CHRONO_ENV_FILE:-}" ] && [ -f "${CHRONO_ENV_FILE}" ]; then . "${CHRONO_ENV_FILE}"; fi

%runscript
    exec /opt/ros_entrypoint.sh "$@"

%labels
    Maintainer UW Simulation Based Engineering Laboratory <pachipala@wisc.edu>
    GPU_Backend HIP/ROCm (AMD Instinct MI210, gfx90a)
    Chrono_Sensor disabled (OptiX is NVIDIA-only)

%help
    Project Chrono (AMD ROCm/HIP build) for HPC Fund.
    1. Build the image (login node):
         cd docker/chrono && apptainer build --fakeroot "$WORK/chrono.sif" chrono.def
    2. Compile Chrono in a GPU job (see build_chrono.slurm):
         sbatch build_chrono.slurm
    3. Run interactively on a GPU node:
         srun -p mi2101x -A dannegrut --pty bash
         apptainer exec --rocm --bind "$WORK" "$WORK/chrono.sif" bash
